{
  "name": "axis-and-allies-classic",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/vite/bin/vite.js build",
    "deploy": "npm run build && node node_modules/wrangler/bin/wrangler.js pages deploy dist --project-name axis-and-allies-classic --branch main --commit-dirty=true",
    "headless": "node node_modules/vite-node/vite-node.mjs scripts/headless.ts",
    "soak": "node node_modules/vite-node/vite-node.mjs scripts/soak.ts",
    "bench": "node node_modules/vite-node/vite-node.mjs scripts/ai-benchmark.ts",
    "tournament": "node node_modules/vite-node/vite-node.mjs scripts/ai-tournament.ts",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "audit:layout": "node node_modules/vite-node/vite-node.mjs scripts/audit-layout.ts",
    "adjacency:diff": "node node_modules/vite-node/vite-node.mjs scripts/adjacency-diff.ts",
    "unit": "node node_modules/vitest/vitest.mjs run",
    "test": "npm run typecheck && npm run unit && npm run audit:layout && npm run soak -- 10 && npm run bench -- 3",
    "test:sim": "npm run soak -- 60 && npm run bench -- 10"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.1",
    "digital-boardgame-framework": "^0.42.0",
    "jszip": "^3.10.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260611.1",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.21",
    "vite-node": "^2.1.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.100.0"
  }
}
